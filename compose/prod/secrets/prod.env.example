# Names of the secrets the stack expects. The real values live in the encrypted
# file prod.enc.env next to this one. Use letters and digits only, so no quoting
# is needed anywhere. Generate each with: openssl rand -hex 24
ELASTIC_PASSWORD=change-me
KIBANA_SYSTEM_PASSWORD=change-me
KIBANA_ENCRYPTION_KEY=change-me-at-least-32-characters-long
API_ES_USERNAME=wortlaut_api
API_ES_PASSWORD=change-me
INDEXER_ES_USERNAME=wortlaut_indexer
INDEXER_ES_PASSWORD=change-me
